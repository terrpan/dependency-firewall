server:
  port: 8080
  readTimeout: 30s
  writeTimeout: 0s
  idleTimeout: 120s

ociCache:
  enabled: false
  backend: disk
  rootDir: "/tmp/dependency-firewall/oci"
  maxBytes: 0
  maxAge: 0s
  maxEntries: 0
  s3:
    bucket: ""
    prefix: ""
    region: ""
    endpoint: ""
  gcs:
    bucket: ""
    prefix: ""

database:
  dsn: "postgres://firewall:firewall@localhost:5432/firewall?sslmode=disable"
  maxOpenConns: 25
  maxIdleConns: 5
  connMaxLifetime: 5m

valkey:
  addr: "localhost:6379"
  password: ""
  db: 0

log:
  level: info
  format: json

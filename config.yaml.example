runtime:
  mode: all-in-one

server:
  port: 8080
  # Five seconds is the runtime default. Increase deliberately for slower clients.
  read_timeout: 5s
  write_timeout: 0s
  idle_timeout: 120s

oci_cache:
  # Consumed by proxy routes in proxy/all-in-one modes. Disk is the only
  # implemented backend. Selecting s3 or gcs currently fails startup.
  enabled: false
  backend: disk
  root_dir: "/tmp/dependency-firewall/oci"
  max_bytes: 0
  max_age: 0s
  max_entries: 0
  s3:
    # Reserved future configuration; not an active backend.
    bucket: ""
    prefix: ""
    region: ""
    endpoint: ""
  gcs:
    # Reserved future configuration; not an active backend.
    bucket: ""
    prefix: ""

database:
  # Used by all-in-one and control-plane modes. Proxy and dependency-graph-worker
  # modes use control-plane gRPC instead of opening PostgreSQL directly.
  dsn: "postgres://firewall:firewall@localhost:5432/firewall?sslmode=disable"
  max_open_conns: 25
  max_idle_conns: 5
  conn_max_lifetime: 5m

valkey:
  # Used by all-in-one, control-plane, and proxy modes. The graph worker does
  # not connect to Valkey.
  addr: "localhost:6379"
  password: ""
  db: 0

log:
  level: info
  format: json

telemetry:
  enabled: false
  # Local collector defaults:
  # - OTLP/gRPC: http://localhost:4317
  # - OTLP/HTTP: http://localhost:4318
  # Valkey client spans emitted by valkey-go report db.system=valkey.
  endpoint: "http://localhost:4317"
  protocol: grpc
  insecure: true
  sample_ratio: 1.0
  stdout: false
  headers: {}
  sql_tracing:
    trim_sql_in_span_name: true
    disable_sql_statement_in_attributes: true

audit:
  enabled: true
  slog: true
  postgres: true
  failure_mode: fail_closed
  detail_level: summary

health:
  # Control-plane split mode only: optionally check the separate proxy health.
  proxy_url: ""

secrets:
  # Optional base64-encoded 32-byte AES key for OCI upstream credentials.
  # Keep the same protected value across control-plane restarts.
  upstream_auth_key: ""

dependency_graph:
  # Resolver jobs normally run in runtime.mode=dependency-graph-worker, where the
  # worker talks to the control plane over mTLS and is the only service that needs
  # Node/npm. Set run_in_process true only for local all-in-one/control-plane
  # compatibility.
  enabled: true
  run_in_process: false
  # Use an explicit tenant ID for a tenant-scoped worker. The wildcard keeps
  # the historical behavior of claiming jobs across all tenants.
  tenant_id: "*"
  poll_interval: 5s
  timeout: 2m
  concurrency: 2
  retry_delay: 5m

bundle:
  # listen_addr and authorized_clients are control-plane settings.
  # control_plane_addr is used by proxy and graph-worker modes.
  listen_addr: ":9090"
  control_plane_addr: "127.0.0.1:9090"
  refresh_interval: 30s
  tls:
    # Proxy and graph-worker modes require mtls. Control-plane mode also
    # requires mtls unless allow_insecure_control_plane is explicitly enabled
    # for local development. all-in-one keeps these adapters in-process.
    mode: insecure
    ca_file: ""
    cert_file: ""
    key_file: ""
    server_name_override: ""
    # Control-plane mode only. Defaults to false. Set true only for local
    # development when intentionally running bundle/ingest gRPC without mTLS.
    # Startup logs will emit a warning when this override is active.
    allow_insecure_control_plane: false
    # Control-plane mode only. Identities are read from the proxy client
    # certificate URI SAN, DNS SAN, email SAN, or Common Name.
    authorized_clients: []

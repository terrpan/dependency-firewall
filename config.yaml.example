runtime:
  mode: all-in-one

server:
  port: 8080
  read_timeout: 30s
  write_timeout: 0s
  idle_timeout: 120s

oci_cache:
  enabled: false
  backend: disk
  root_dir: "/tmp/dependency-firewall/oci"
  max_bytes: 0
  max_age: 0s
  max_entries: 0
  s3:
    bucket: ""
    prefix: ""
    region: ""
    endpoint: ""
  gcs:
    bucket: ""
    prefix: ""

database:
  # Used by all-in-one and control-plane modes. Proxy and dependency-graph-worker
  # modes use control-plane gRPC instead of opening PostgreSQL directly.
  dsn: "postgres://firewall:firewall@localhost:5432/firewall?sslmode=disable"
  max_open_conns: 25
  max_idle_conns: 5
  conn_max_lifetime: 5m

valkey:
  # Used by the valkey-go client; the endpoint/password/db config stays the same.
  addr: "localhost:6379"
  password: ""
  db: 0

log:
  level: info
  format: json

telemetry:
  enabled: false
  # Local collector defaults:
  # - OTLP/gRPC: http://localhost:4317
  # - OTLP/HTTP: http://localhost:4318
  # Valkey client spans emitted by valkey-go report db.system=valkey.
  endpoint: "http://localhost:4317"
  protocol: grpc
  insecure: true
  sample_ratio: 1.0
  stdout: false
  headers: {}

audit:
  enabled: true
  slog: true
  postgres: true
  failure_mode: fail_closed
  detail_level: summary

health:
  proxy_url: ""

dependency_graph:
  # Resolver jobs normally run in runtime.mode=dependency-graph-worker, where the
  # worker talks to the control plane over mTLS and is the only service that needs
  # Node/npm. Set run_in_process true only for local all-in-one/control-plane
  # compatibility.
  enabled: true
  run_in_process: false
  # Use an explicit tenant ID for a tenant-scoped worker. The wildcard keeps
  # the historical behavior of claiming jobs across all tenants.
  tenant_id: "*"
  poll_interval: 5s
  timeout: 2m
  concurrency: 2
  retry_delay: 5m

bundle:
  listen_addr: ":9090"
  control_plane_addr: "127.0.0.1:9090"
  refresh_interval: 30s
  tls:
    # Split control-plane/proxy mode should use mtls. all-in-one local
    # development can keep insecure because bundle and ingest stay in-process.
    mode: insecure
    ca_file: ""
    cert_file: ""
    key_file: ""
    server_name_override: ""
    # Control-plane mode only. Defaults to false. Set true only for local
    # development when intentionally running bundle/ingest gRPC without mTLS.
    # Startup logs will emit a warning when this override is active.
    allow_insecure_control_plane: false
    # Control-plane mode only. Identities are read from the proxy client
    # certificate URI SAN, DNS SAN, email SAN, or Common Name.
    authorized_clients: []

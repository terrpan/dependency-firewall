runtime:
  mode: all-in-one

server:
  port: 8080
  read_timeout: 30s
  write_timeout: 0s
  idle_timeout: 120s

oci_cache:
  enabled: false
  backend: disk
  root_dir: "/tmp/dependency-firewall/oci"
  max_bytes: 0
  max_age: 0s
  max_entries: 0
  s3:
    bucket: ""
    prefix: ""
    region: ""
    endpoint: ""
  gcs:
    bucket: ""
    prefix: ""

database:
  # Used by all-in-one and control-plane modes.
  # Proxy mode reads tenant runtime from bundles and writes decisions/audit
  # through the control plane instead of opening PostgreSQL directly.
  dsn: "postgres://firewall:firewall@localhost:5432/firewall?sslmode=disable"
  max_open_conns: 25
  max_idle_conns: 5
  conn_max_lifetime: 5m

valkey:
  addr: "localhost:6379"
  password: ""
  db: 0

log:
  level: info
  format: json

telemetry:
  enabled: false
  # Local collector defaults:
  # - OTLP/gRPC: http://localhost:4317
  # - OTLP/HTTP: http://localhost:4318
  endpoint: "http://localhost:4317"
  protocol: grpc
  insecure: true
  sample_ratio: 1.0
  stdout: false
  headers: {}

audit:
  enabled: true
  slog: true
  postgres: true
  failure_mode: fail_closed
  detail_level: summary

health:
  proxy_url: ""

bundle:
  listen_addr: ":9090"
  control_plane_addr: "127.0.0.1:9090"
  refresh_interval: 30s

FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/firewall ./cmd/firewall

FROM node:24-alpine

RUN apk add --no-cache ca-certificates
COPY --from=build /out/firewall /usr/local/bin/firewall

ENTRYPOINT ["/usr/local/bin/firewall"]
CMD ["-mode=dependency-graph-worker"]
